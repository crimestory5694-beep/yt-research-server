# Copy these NAMES into Render -> service -> Environment. Never commit real values.

# --- required ---
YOUTUBE_API_KEY=            # NEW key (rotate the old one!), restricted to "YouTube Data API v3"

# --- security (recommended) ---
MCP_AUTH_TOKEN=             # long random string; when set, /mcp /messages /sse require it
# MCP_AUTH_TOKENS=          # comma-separated, for zero-downtime token rotation
# RATE_LIMIT_PER_MINUTE=120 # per client on POST /mcp and /messages; 0 disables
# CORS_ALLOW_ORIGINS=*      # comma-separated origins; default * (unchanged behaviour)

# --- transcripts: free-first (all optional) ---
# TRANSCRIPT_PROVIDER_ORDER=youtube_direct,youtube_proxy,transcriptapi,supadata
# TRANSCRIPT_CACHE_PATH=/data/transcript_cache.sqlite3   # set ONLY if it is on a persistent disk (paid Render plans)
# TRANSCRIPT_CACHE_TTL_DAYS=30
# TRANSCRIPT_NEGATIVE_TTL_HOURS=6
# TRANSCRIPT_TIMEOUT_SECONDS=20
# TRANSCRIPT_TOTAL_TIMEOUT_SECONDS=90
# TRANSCRIPT_MAX_CONCURRENCY=4
# TRANSCRIPT_FETCHES_PER_MINUTE=30
# TRANSCRIPT_BLOCK_COOLDOWN_SECONDS=300

# --- optional proxy (only used AFTER direct access is blocked) ---
# WEBSHARE_USER=            # requires a Webshare *Residential* plan (not "Proxy Server"/"Static Residential")
# WEBSHARE_PASS=
# PROXY_URL=                # alternative: any http(s) proxy URL
# TRANSCRIPT_PROXY_RETRIES=3

# --- optional paid APIs: OFF by default ---
# ENABLE_PAID_TRANSCRIPT_APIS=false   # must be "true" for the two keys below to be used at all
# PAID_TRANSCRIPT_MONTHLY_LIMIT=50    # max calls per provider per UTC month
# ALLOW_PAID_WITH_EPHEMERAL_STATE=false  # paid calls are refused on ephemeral disks unless TRANSCRIPT_CACHE_PATH is set or this is true
# TRANSCRIPT_API_KEY=
# SUPADATA_API_KEY=

# --- one-time verification on a THROWAWAY test service only ---
# RUN_TRANSCRIPT_PROBE_ON_STARTUP=true   # logs one TRANSCRIPT_PROBE_RESULT line; paid APIs are force-disabled
# CLIENT_IP_HEADER=true-client-ip        # optional: rate-limit key header if X-Forwarded-For is a shared proxy IP
