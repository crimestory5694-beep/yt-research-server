# Copy to  %APPDATA%\yt-worker\worker.env  (the installer does this for you). NEVER share this file.
RENDER_URL=https://YOUR-SERVICE.onrender.com
WORKER_TOKEN=paste-the-long-random-worker-token-here
# WORKER_ID=my-laptop
# Pacing (defaults shown; lower numbers are NOT recommended)
# MIN_DELAY_SECONDS=20
# MAX_DELAY_SECONDS=45
# HOURLY_CAP=20
# DAILY_CAP=120
# POLL_MIN_SECONDS=300
# POLL_MAX_SECONDS=1800
# ENABLE_YTDLP=false
# Optional "doorbell" so idle checks do not wake the free Render service: a READ-ONLY Upstash token (never the full one)
# UPSTASH_READONLY_URL=https://xxxx.upstash.io
# UPSTASH_READONLY_TOKEN=
